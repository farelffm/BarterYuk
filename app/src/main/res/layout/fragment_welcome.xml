<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_gradient">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">


            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- 2. Selamat Datang! -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat Datang!"
                android:textColor="#0D47A1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- 3. BarterYuk -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BarterYuk"
                android:textColor="#0D47A1"
                android:textSize="36sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- 4. Description Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Exchange goods with your neighbors. Build trust, reduce waste, and find what your need locally without spending money"
                android:textColor="#444444"
                android:textSize="14sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <!-- 5. Daftar Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Daftar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#1A1A1A"
                app:cornerRadius="16dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <!-- 6. Masuk Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Masuk"
                android:textAllCaps="false"
                android:textColor="#0D47A1"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="#0D47A1" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <!-- 7. Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="atau masuk dengan"
                android:textColor="#888888"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#F5F5F5"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="@android:color/black" />

                <Space
                    android:layout_width="20dp"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#F5F5F5"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@android:color/black" />

                <Space
                    android:layout_width="20dp"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#F5F5F5"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@android:color/black" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 1. Circular Logo (Menggunakan MaterialCardView agar benar-benar terpotong bulat) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logoFrame"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="40dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toTopOf="@id/cardWelcome"
        app:layout_constraintEnd_toEndOf="@id/cardWelcome"
        app:layout_constraintStart_toStartOf="@id/cardWelcome"
        app:layout_constraintTop_toTopOf="@id/cardWelcome"
        app:strokeColor="#0D47A1"
        app:strokeWidth="2dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_launcher_round" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>