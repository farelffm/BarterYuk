<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Gambar Utama sebagai Background -->
        <ImageView
            android:id="@+id/ivItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/desc_product_image"
            android:src="@android:drawable/ic_menu_report_image"
            android:background="#EEEEEE" />

        <!-- Ikon Kategori (Kiri Atas) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="8dp"
            app:cardBackgroundColor="#CCFFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/category_title"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#0D47A1" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Ikon Kondisi (Kanan Atas) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_margin="8dp"
            app:cardBackgroundColor="#CC0D47A1"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/ivConditionIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/desc_condition_icon"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Overlay Detail (Nama & Pemilik di bawah gambar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#AA000000"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/dummy_item_name"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemOwner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/dummy_item_owner"
                android:textColor="#DDDDDD"
                android:textSize="11sp" />
        </LinearLayout>

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>